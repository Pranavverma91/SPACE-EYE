# Local development values. Change the database password before hosting.
POSTGRES_PASSWORD=spaceeye-local-change-me
DATABASE_URL=postgresql+psycopg://spaceeye:spaceeye-local-change-me@localhost:5432/spaceeye
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=data/storage
MODEL_DIR=data/checkpoints
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# False is only for local plain HTTP. Use true behind HTTPS.
SESSION_SECURE=false
SESSION_HOURS=24
MAX_UPLOAD_MB=256
MAX_RASTER_PIXELS=100000000
# Fixed server-side upstream; never exposed as NEXT_PUBLIC_...
SCIENCE_API_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# TESTING must remain false outside the isolated automated tests.
TESTING=false
