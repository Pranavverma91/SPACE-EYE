FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt backend/requirements.txt
COPY ai/requirements.txt ai/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.14.0
COPY backend backend
COPY ai ai
COPY scripts scripts
COPY pyproject.toml pyproject.toml
RUN useradd --uid 10001 --create-home researcher && mkdir -p data/storage data/checkpoints && chown -R researcher:researcher /app/data
USER researcher
EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
